{
  "maxtext_version": "0.2.2",
  "common_overrides": {
    "steps": 50,
    "dataset_type": "synthetic",
    "per_device_batch_size": 1,
    "max_target_length": 32,
    "log_period": 1,
    "enable_checkpointing": false,
    "async_checkpointing": false,
    "save_checkpoint_on_completion": false,
    "enable_tensorboard": true,
    "gcs_metrics": false,
    "save_config_to_gcs": false,
    "dtype": "bfloat16",
    "weight_dtype": "bfloat16",
    "grad_dtype": "float32",
    "attention": "dot_product",
    "remat_policy": "full",
    "scan_layers": true,
    "skip_jax_distributed_system": true,
    "base_output_directory": "/content/zenteiq_maxtext_outputs"
  },
  "models": {
    "qwen3_0_6b": {
      "architecture": "dense",
      "display_name": "Qwen3 0.6B base",
      "maxtext_model_name": "qwen3-0.6b",
      "overrides": {}
    },
    "qwen3_scaled_1b": {
      "architecture": "dense",
      "display_name": "Qwen3 scaled approximately 1B",
      "maxtext_model_name": "qwen3-0.6b",
      "overrides": {
        "override_model_config": true,
        "base_emb_dim": 1280,
        "base_num_query_heads": 20,
        "base_num_kv_heads": 10,
        "base_mlp_dim": 3840,
        "base_num_decoder_layers": 32,
        "head_dim": 128,
        "vocab_size": 151936
      }
    },
    "deepseek_moe_under_1b": {
      "architecture": "moe",
      "display_name": "DeepSeek MoE scaled under 1B",
      "maxtext_model_name": "deepseek2-16b",
      "overrides": {
        "override_model_config": true,
        "base_emb_dim": 1024,
        "base_num_query_heads": 8,
        "base_num_kv_heads": 8,
        "base_mlp_dim": 4096,
        "base_moe_mlp_dim": 768,
        "base_num_decoder_layers": 12,
        "first_num_dense_layers": 2,
        "vocab_size": 102400,
        "num_experts": 8,
        "num_experts_per_tok": 2,
        "shared_experts": 1,
        "sparse_matmul": false,
        "megablox": false,
        "routed_scaling_factor": 1.0,
        "routed_score_func": "softmax",
        "routed_bias": false,
        "q_lora_rank": 0,
        "kv_lora_rank": 256,
        "qk_nope_head_dim": 64,
        "qk_rope_head_dim": 32,
        "v_head_dim": 128,
        "max_position_embeddings": 4096,
        "original_max_position_embeddings": 4096,
        "rope_factor": 1
      }
    }
  },
  "runs": [
    {
      "run_id": "dense_qwen_0_6b_cpu",
      "backend": "cpu",
      "model_key": "qwen3_0_6b"
    },
    {
      "run_id": "dense_qwen_0_6b_gpu",
      "backend": "gpu",
      "model_key": "qwen3_0_6b",
      "overrides": {
        "dtype": "float16",
        "weight_dtype": "float16"
      }
    },
    {
      "run_id": "dense_qwen_0_6b_tpu",
      "backend": "tpu",
      "model_key": "qwen3_0_6b"
    },
    {
      "run_id": "dense_qwen_scaled_1b_cpu",
      "backend": "cpu",
      "model_key": "qwen3_scaled_1b"
    },
    {
      "run_id": "dense_qwen_scaled_1b_gpu",
      "backend": "gpu",
      "model_key": "qwen3_scaled_1b",
      "overrides": {
        "dtype": "float16",
        "weight_dtype": "float16"
      }
    },
    {
      "run_id": "dense_qwen_scaled_1b_tpu",
      "backend": "tpu",
      "model_key": "qwen3_scaled_1b"
    },
    {
      "run_id": "moe_deepseek_under_1b_cpu",
      "backend": "cpu",
      "model_key": "deepseek_moe_under_1b"
    },
    {
      "run_id": "moe_deepseek_under_1b_gpu",
      "backend": "gpu",
      "model_key": "deepseek_moe_under_1b",
      "overrides": {
        "dtype": "float16",
        "weight_dtype": "float16"
      }
    },
    {
      "run_id": "moe_deepseek_under_1b_tpu",
      "backend": "tpu",
      "model_key": "deepseek_moe_under_1b"
    }
  ]
}
